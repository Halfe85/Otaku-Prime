<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.otaku.prime" name="Otaku Prime" provider-name="Otaku Prime" version="0.1.4">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="context.otaku" version="1.0.34"/>
  </requires>
  <extension library="main.py" point="xbmc.python.pluginsource">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en">Otaku Prime watchlist connector</summary>
    <description lang="en">Otaku Prime connects AniList, MyAnimeList, Kitsu, and Simkl and stores their raw watchlist snapshots locally.</description>
    <platform>all</platform>
    <license>GPL-3.0</license>
    <source>https://github.com/Halfe85/Otaku-Prime</source>
  </extension>
</addon>
